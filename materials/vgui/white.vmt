// HL2SB: GMod's material path for a plain white 2D texture.
//
// draw.NoTexture() and a lot of GMod Lua ask for Material( "vgui/white" ).
// The mounted VPKs do not ship it, so it is provided here; white.png is loaded
// by the fork's image fallback when the .vtf is absent.
"UnlitGeneric"
{
	"$basetexture" "vgui/white"
	"$vertexcolor" 1
	"$vertexalpha" 1
	"$translucent" 1
	"$ignorez" 1
	"$nolod" 1
}
