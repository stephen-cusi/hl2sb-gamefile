"UnlitGeneric"
{
	// HL2SB GMod compat: forced onto the physgun-held entity as an additive
	// self-shell (drawn AFTER the normal pass).  Kept dim -- additive over an
	// already bright surface doubles up fast; [0.5 0.75 1] used to wash the
	// whole model to near-white.
	"$baseTexture"	"models/debug/debugwhite"
	"$model"		"1"
	"$additive"		"1"
	"$nocull"		"1"
	"$no_fullbright" "1"
	"$color"		"[0.10 0.22 0.45]"
}
