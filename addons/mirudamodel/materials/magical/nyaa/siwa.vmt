"VertexLitGeneric"
{
	"$basetexture" "Magical\nyaa\yifu"
	"$bumpmap"					"Magical\nyaa\yifu_n"	// 法线贴图。没有用到就不要启用。
																	// 特别地，引用所谓纯色法线贴图可能会导致 UV 边缘出现光照异常。
	
	"$lightwarptexture" 			"Magical\nyaa\toon_light"			// 色彩校正。二次元必加。不推荐自制，一般会有格式问题导致效果异常。
	
    "$nocull" 						"1"			// 双面渲染。单面模型正反两处都暴露的话，一般都开。模型的边缝漏色严重可以关。
	"$nodecal" 						"1"			// 贴花阻止。关闭血迹。可以防止一些神秘闪退。
	"$phong" 						"1"			// 冯氏反射开关。半透明面和全息面可以关。
	"$halflambert" 					"1"			// 半兰伯特光照。让光照过渡更加自然，必开。

	"$phongboost"					".04"       // 冯氏反射亮度。亮度区分取决于法线贴图的A通道，越白则越亮。
												// 若为了金属而修改了该通道，其值应需要进一步增加，参考翻 100 倍（ .04 → 4 ）
												// 启用 $phongexponenttexture 之后，其值或许需要进一步增加，参考翻 20 倍（ 4 → 80 ）。
	
	//"$phongexponenttexture"		"ko/vrc/lime/def/ppp_exp"		// 冯氏密度贴图 / 高光贴图。原理较为复杂，详见文档。一般不启用。
																	// 为启用 $phongalbedotint，引用所谓纯色高光贴图或许是可以接受的。
															
	"$phongalbedotint"				"1" 				// 按颜色贴图区分冯氏反射颜色。必须启用 $phongexponenttexture 才有效。效果需仔细观察。
	//"$phongexponent" 				"5.0" 				// 冯氏反射密度。启用后将覆盖 $phongexponenttexture。默认即5.0。一般不做修改。
	//"$phongtint" 					"[1 1 1]" 			// 全局冯氏反射通道强度。启用后将覆盖 $phongalbedotint。为比例关系，只能调色。
	"$phongfresnelranges"			"[1 .1 .1]" 		// 冯氏反射菲涅尔参数。原理较为复杂，详见文档。不要乱调。
	
	//"$envmap"						"env_cubemap" 		// 镜面反射。和冯氏反射不同，与所处地图位置而非与光源有关。不做金属不要开。
	"$normalmapalphaenvmapmask"		"1" 				// 将法线贴图 A 通道作为镜面反射蒙版。镜面反射效果区分将取决于法线贴图的A通道，越白越显著。保持启用。
	"$envmapfresnel"				"1" 				// 启用镜面反射菲涅尔效果。该值将与冯氏反射菲涅尔参数做乘法。不要乱调。
	"$envmaptint"					"[ 0.4 0.4 0.4 ]" 	// 镜面反射通道强度。整体越大，镜面反射越明显。不单为比例关系，可以调色。
	
	//"$selfillum" 					"1" 				// 开启自发光。亮度区分取决于颜色贴图的 A 通道，越白则越亮。不做自发光必须关掉。
	//"$selfillummask"                "diyu2024/share/selfillum/mask"         //自发光通道，可以在使用A透的情况下与夜光共存。
	//"$additive"					"1"					// 开启颜色叠加，具有半透明效果，透明程度区分取决于颜色贴图的 RGB 通道（灰度），黑色为完全透明。
														// 可与自发光一同开启，用以制作全息镜效果。
	"$translucent"				"1" 				// 开启半透明。透明程度区分取决于颜色贴图的 A 通道，越白则越不透明。和自发光冲突。
	//"$alpha" 						"0.5" 				// 透明度缩放。该透明效果不会影响阴影效果。
														// 特别地，通过材质代理影响该参数时，手电阴影将会失效。
	
	
	// 文档：https://developer.valvesoftware.com/wiki/$phong/en // 冯氏反射
}